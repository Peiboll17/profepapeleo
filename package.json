{
  "name": "profepapeleo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Elimina el papeleo del docente en España: trámites, programaciones y documentos de centro",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "vite build --base=/profepapeleo/ && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
